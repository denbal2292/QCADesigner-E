// Windows resources for QCADesignerE.exe: its icon, and the details in its Properties dialog.
// build-windows.sh compiles this with windres, defining QCAD_VERSION_COMMA (such as 2,3,2,0)
// and QCAD_VERSION_STR (such as "2.3.2").
#include <winver.h>

// The icon Windows shows for the program, built from pixmaps/QCADesignerE.svg
1 ICON "QCADesignerE.ico"

1 VERSIONINFO
FILEVERSION     QCAD_VERSION_COMMA
PRODUCTVERSION  QCAD_VERSION_COMMA
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "QCADesigner-E"
      VALUE "ProductName",      "QCADesigner-E"
      VALUE "FileVersion",      QCAD_VERSION_STR
      VALUE "ProductVersion",   QCAD_VERSION_STR
      VALUE "OriginalFilename", "QCADesignerE.exe"
      VALUE "LegalCopyright",   "GNU General Public License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
